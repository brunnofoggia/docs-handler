{
    "name": "docs-handler",
    "version": "0.16.1",
    "description": "",
    "license": "ISC",
    "author": "Bruno Foggia",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "scripts": {
        "husky:install": "husky install",
        "exec:kms": "IS_TS_NODE=true ts-node -r tsconfig-paths/register test/kms",
        "prebuild": "rimraf lib",
        "build": "tsc -p ./tsconfig.build.json",
        "lint": "eslint \"{src,apps,libs}/**/*.+(js|json|ts|tsx)\" --fix",
        "pre-commit": "lint-staged",
        "prepare": "npm run build",
        "test": "npm run test:docker:up && npm run test:run",
        "test:run": "NODE_OPTIONS=--experimental-vm-modules npx jest --verbose --detectOpenHandles",
        "test:docker:up": "docker compose up -d",
        "test:docker:down": "docker compose down"
    },
    "dependencies": {
        "cloud-solutions": "^4.5.0",
        "debug": "^4.4.3",
        "ejs": "^3.1.10",
        "lodash": "^4.17.21"
    },
    "devDependencies": {
        "@babel/core": "^7.28.4",
        "@babel/preset-env": "^7.28.3",
        "@commitlint/config-conventional": "^20.0.0",
        "@faker-js/faker": "^8.4.0",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.20",
        "@types/node": "^24.7.0",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "axios": "^1.12.2",
        "babel-jest": "^30.2.0",
        "commitlint": "^20.1.0",
        "cz-conventional-changelog": "^3.3.0",
        "dotenv": "^17.2.3",
        "eslint": "^9.37.0",
        "git-commit-msg-linter": "^5.0.8",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "lint-staged": "^16.2.3",
        "node-fpdf": "^1.0.49",
        "pdfkit": "^0.17.2",
        "pg": "^8.16.3",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.4.4",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typeorm": "^0.3.27",
        "typescript": "^5.9.3"
    },
    "files": [
        "/lib"
    ],
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}